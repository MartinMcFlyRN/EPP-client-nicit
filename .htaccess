
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    # internal folders and files are never reachable
    RewriteRule ^(src|config|sql|templates|views|tests|bin|deploy|lang|storage)(/|$) - [F,L]
    RewriteRule (^|/)\. - [F,L]
    RewriteRule ^(README\.md|composer\.(json|lock))$ - [F,L]

    # everything else is served from public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>

